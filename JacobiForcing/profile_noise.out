Generated answers: ```python
from string import ascii_lowercase, ascii_uppercase

def encode(message):
    """
    Write a function that takes a message, and encodes in such a 
    way that it swaps case of all letters, replaces all vowels in 
    the message with the letter that appears 2 places ahead of that 
    vowel in the english alphabet. 
    Assume only letters. 
    
    Examples:
    >>> encode('test')
    'TGST'
    >>> encode('This is a message')
    'tHKS KS C MGSSCGG'
    """
    vowels_lower = 'aeiou'
    vowels_upper = 'AEIOU'
    alphabet_lower = ascii_lowercase
    alphabet_upper = ascii_uppercase
    
    def shift_vowel(vowel):
        if vowel in vowels_lower:
            index = vowels_lower.index(vowel)
            return alphabet_lower[(index + 2) % 26]
        elif vowel in vowels_upper:
            index = vowels_upper.index(vowel)
            return alphabet_upper[(index + 2) % 26]
        else:
            return vowel
    
    encoded_message = []
    for char in message:
        if char.isalpha():
            if char.islower():
                new_char = shift_vowel(char).upper()
            else:
                new_char = shift_vowel(char).lower()
            encoded_message.append(new_char.swapcase())
        else:
            encoded_message.append(char)
    
    return ''.join(encoded_message)
