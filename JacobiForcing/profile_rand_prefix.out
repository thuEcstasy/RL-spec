def iscube(a):
    '''
    Write a function that takes an integer a and returns True 
    if this integer is is a cube of some integer number.
    Note: you may assume the input is always valid.
    Examples:
    iscube(1) ==> True
    iscube(2) ==> False
    iscube(-1) ==> True
    iscube(64) ==> True
    iscube(0) ==> True
    iscube(180) ==> False
    '''
    # Calculate the cube root of the absolute value of a
    cube_root = abs(a) ** (1/3)
    # Check if the cube root is an integer by comparing it to its rounded value
    return cube_root == round(cube_root)
