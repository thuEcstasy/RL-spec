    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])
    [1, 5, 653]
    >>> common([5, 3, 2, 8], [3, 2])
    [2, 3]

    """
    # Convert both lists to sets to remove duplicates and allow for efficient intersection
    set1 = set(l1)
    set2 = set(l2)
    
    # Find the intersection of both sets to get common elements
    common_elements = set1.intersection(set2)
    
    # Convert the set of common elements back to a sorted list
    sorted_common_elements = sorted(list(common_elements))
    
    return sorted_common_elements
